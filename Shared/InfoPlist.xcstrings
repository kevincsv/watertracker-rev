    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan barcodes, read nutrition labels and photograph meals. Photos are not saved or sent anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para escanear códigos de barras, leer etiquetas nutricionales y fotografiar comidas. Las fotos no se guardan ni se envían."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC reads your water intake from Apple Health to show your progress. For the Meals tab it reads the calories you have eaten and burned, your workouts, weight, height, age and sex to work out your daily calorie target on this device. If you turn on the automatic water goal, it also reads your pregnancy status and, if you choose, your menstrual cycle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC lee tu consumo de agua de Apple Health para mostrar tu progreso. Para la pestaña Comidas lee las calorías que has comido y quemado, tus entrenos, peso, altura, edad y sexo para calcular tu objetivo de calorías en este dispositivo. Si activas la meta automática del agua, también lee tu embarazo y, si lo eliges, tu ciclo menstrual."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC saves the water, meals (calories and macros) and weight you log to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC guarda en Apple Health el agua, las comidas (calorías y macros) y el peso que registras."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
