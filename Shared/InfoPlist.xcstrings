    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC reads your water intake from Apple Health to show your progress. If you turn on the automatic goal, it also reads your sex, weight, workouts, pregnancy and, if you choose, your menstrual cycle to work out your daily goal on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC lee tu consumo de agua de Apple Health para mostrar tu progreso. Si activas la meta automática, también lee tu sexo, peso, entrenos, embarazo y, si lo eliges, tu ciclo menstrual para calcular tu meta diaria en este dispositivo."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC saves the water you log to Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Water Tracker KC guarda en Apple Health el agua que registras."
          }
        }
      }
    }
  },
  "version" : "1.0"
