    "Las comidas se guardan en la app Salud con calorías, proteína, carbohidratos y grasa. Para que WHOOP las lea, en la app Salud ve a Compartir > Apps > WHOOP y activa la lectura de nutrición." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meals are saved to the Health app with calories, protein, carbs and fat. For WHOOP to read them, open the Health app, go to Sharing > Apps > WHOOP and turn on reading nutrition."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comidas se guardan en la app Salud con calorías, proteína, carbohidratos y grasa. Para que WHOOP las lea, en la app Salud ve a Compartir > Apps > WHOOP y activa la lectura de nutrición."
          }
        }
      }
    },
    "Privacidad" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
