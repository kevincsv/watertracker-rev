      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peso"
          }
        }
      }
    },
    "Worked out from your body, today's workouts and the options below, and updated whenever you open the app. It is a guide, not medical advice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se calcula con tu cuerpo, los entrenos de hoy y las opciones de abajo, y se actualiza cada vez que abres la app. Es una guía, no un consejo médico."
          }
        }
      }
    },
    "Workouts" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenos"
          }
        }
      }
    },
    "Workouts today" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenos de hoy"
          }
        }
      }
    },
    "Your water is saved in Apple Health, and your settings sync through your own iCloud. This app has no account, no analytics and no servers of its own." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu agua se guarda en Apple Health y tus ajustes se sincronizan con tu propio iCloud. Esta app no tiene cuenta, ni analíticas, ni servidores propios."
          }
        }
      }
    },
