    "No body fat readings yet. The figure estimates it from your BMI, age and sex, which can be off by about 4 points." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay datos de grasa corporal. La figura la estima con tu IMC, edad y sexo, y puede fallar unos 4 puntos."
          }
        }
      }
    },
    "No comparison" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
