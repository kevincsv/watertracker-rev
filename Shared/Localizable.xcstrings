    "Ranked by how close each person got to their own daily goal, so different goals compare fairly." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenado según lo cerca que estuvo cada uno de su propia meta diaria, para que metas distintas se comparen de forma justa."
          }
        }
      }
    },
    "Ranking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasificación"
          }
        }
      }
    },
    "Reminders" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios"
          }
        }
      }
    },
    "Reminders count from your last drink, stay silent outside these hours, and stop for the day once you reach your goal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios cuentan desde tu último registro, no suenan fuera de este horario y se detienen por hoy cuando cumples la meta."
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar"
          }
        }
      }
    },
