    "Dots are weigh-ins and the line is the trend. Hollow dots were far off and not confirmed by the next weigh-in, so they do not move the trend." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos son las pesadas y la línea es la tendencia. Los puntos huecos se salían mucho y la siguiente pesada no los confirmó, así que no mueven la tendencia."
          }
        }
      }
    },
