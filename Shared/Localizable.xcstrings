        }
      }
    },
    "Reminders count from your last drink, stay silent outside these hours, and stop for the day once you reach your goal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios cuentan desde tu último registro, no suenan fuera de este horario y se detienen por hoy cuando cumples la meta."
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes"
          }
        }
      }
    },
    "Sex" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sexo"
          }
        }
      }
    },
    "Sex, weight, workouts, pregnancy and cycle are read from Apple Health, including what WHOOP or other apps save there. Leave weight empty to use the one in Health. This data is only read and used on this device; just your choices here sync through your iCloud." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sexo, el peso, los entrenos, el embarazo y el ciclo se leen de Apple Health, incluido lo que WHOOP u otras apps guardan ahí. Deja el peso vacío para usar el de Salud. Estos datos solo se leen y se usan en este dispositivo; lo único que se sincroniza por tu iCloud son las opciones de esta pantalla."
          }
        }
      }
    },
    "Shows how much water you have logged today." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cuánta agua has registrado hoy."
          }
        }
      }
    },
