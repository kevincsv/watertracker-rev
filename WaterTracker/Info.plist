<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Lets iOS open the app when a friend's iCloud invitation is tapped. -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- The Withings developer app, filled in from GitHub secrets by the
	     TestFlight workflow. Empty in other builds. -->
	<key>WithingsClientID</key>
	<string>$(WITHINGS_CLIENT_ID)</string>
	<key>WithingsClientSecret</key>
	<string>$(WITHINGS_CLIENT_SECRET)</string>
</dict>
</plist>
